DATABASE_URL="postgresql://greenwave:greenwave@localhost:5432/greenwave?schema=public"
BETTER_AUTH_SECRET="replace-with-a-32-char-random-string"
BETTER_AUTH_URL="http://localhost:3000"
MAPBOX_PUBLIC_TOKEN="pk.your-mapbox-public-token"

# TomTom Route Monitoring API
TOMTOM_API_KEY="your-tomtom-api-key"

# Shared secret the hourly scheduler sends as `Authorization: Bearer …`
# Generate with: openssl rand -hex 32
CRON_SECRET="replace-with-a-random-string-of-at-least-16-chars"

# Optional: direct (non-pooled) URL for Prisma Migrate when DATABASE_URL is a
# pooler. Neon's Vercel integration sets this automatically.
# DATABASE_URL_UNPOOLED=""

# Local MQTT. Generate each password separately with: openssl rand -hex 16
# Required by mosquitto-init, including when running pnpm db:up.
MQTT_URL="mqtt://localhost:1883"
MQTT_WS_URL="ws://localhost:9001"
MQTT_ADAPTER_PASSWORD=""
MQTT_BACKEND_PASSWORD=""
BACKEND_CLIENT_ID="backend-1"
