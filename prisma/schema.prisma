generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String   @id @default(cuid())
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sessions Session[]
  accounts Account[]
  devices  Device[]

  @@map("user")
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model Device {
  id        String   @id @default(cuid())
  name      String
  location  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  readings Reading[]

  @@index([ownerId])
  @@map("device")
}

model Reading {
  id          String   @id @default(cuid())
  recordedAt  DateTime @default(now())
  temperature Decimal  @db.Decimal(6, 2)
  humidity    Decimal  @db.Decimal(6, 2)

  deviceId String
  device   Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([deviceId, recordedAt])
  @@map("reading")
}

/// Mirrors the `routeStatus` union in src/lib/traffic/schema.ts. Assigning the
/// Zod value to this column in mutations.ts is what makes the two fail to
/// compile if they ever drift apart.
enum TrafficRouteStatus {
  NEW
  ACTIVE
  PENDING_UPDATE
  MM_FAILED
  ARCHIVED

  @@map("traffic_route_status")
}

/// A TomTom monitored route. `id` is TomTom's own routeId.
model TrafficRoute {
  id           Int                @id
  name         String
  status       TrafficRouteStatus
  lengthMeters Int
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  segments  TrafficSegment[]
  snapshots TrafficSnapshot[]

  @@map("traffic_route")
}

/// Road geometry is static, so it is stored once per segment rather than on
/// every snapshot. `segmentIdStr` is TomTom's id as a string: the numeric form
/// exceeds Number.MAX_SAFE_INTEGER and does not survive JSON parsing.
model TrafficSegment {
  id           String @id @default(cuid())
  segmentIdStr String
  ordinal      Int
  lengthMeters Int
  shape        Json

  routeId Int
  route   TrafficRoute @relation(fields: [routeId], references: [id], onDelete: Cascade)

  @@unique([routeId, segmentIdStr])
  @@index([routeId, ordinal])
  @@map("traffic_segment")
}

/// One poll of a route: the route-level totals plus the per-segment speeds that
/// actually change between polls.
model TrafficSnapshot {
  id                String   @id @default(cuid())
  recordedAt        DateTime @default(now())
  travelTime        Int
  typicalTravelTime Int
  delayTime         Int
  completeness      Int
  routeConfidence   Int
  passable          Boolean
  segmentSpeeds     Json

  routeId Int
  route   TrafficRoute @relation(fields: [routeId], references: [id], onDelete: Cascade)

  @@index([routeId, recordedAt])
  @@map("traffic_snapshot")
}
