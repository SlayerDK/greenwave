{
  "name": "greenwave",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter @greenwave/frontend dev",
    "build": "pnpm --filter @greenwave/frontend build",
    "lint": "eslint",
    "format": "prettier --write .",
    "analyze": "fallow",
    "analyze:ci": "fallow audit",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest",
    "db:up": "docker compose up -d postgres mosquitto",
    "db:down": "docker compose down",
    "broker:verify": "node broker/verify.mjs",
    "db:migrate": "pnpm --filter @greenwave/database migrate:dev",
    "db:generate": "pnpm --filter @greenwave/database generate",
    "db:seed": "pnpm --filter @greenwave/database seed",
    "db:import-traffic-stats": "pnpm --filter @greenwave/frontend import-traffic-stats",
    "build-vercel": "prisma generate && prisma migrate deploy && next build",
    "preinstall": "npx only-allow pnpm",
    "postinstall": "pnpm --filter @greenwave/database generate",
    "prepare": "husky"
  },
  "devDependencies": {
    "@ls-lint/ls-lint": "^2.3.1",
    "@types/node": "catalog:",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "fallow": "^3.30.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "only-allow": "^1.2.2",
    "prettier": "^3.9.9",
    "prettier-plugin-organize-imports": "^4.3.0",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "catalog:",
    "typescript-eslint": "^8.70.1",
    "vitest": "catalog:"
  },
  "packageManager": "pnpm@12.6.0",
  "lint-staged": {
    "*.{ts,tsx,mjs,mts,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css,yml,yaml}": [
      "prettier --write"
    ]
  }
}
