{
  "$schema": "./node_modules/fallow/schema.json",
  "ignorePatterns": ["database/src/generated/**", "**/*.generated.ts"],
  "ignoreExports": [
    {
      "file": "frontend/src/components/ui/**",
      "exports": ["*"]
    }
  ],
  "health": {
    "ignore": ["frontend/src/components/ui/**"]
  },
  "ignoreDependencies": ["pg", "@ls-lint/ls-lint", "react-is"],
  "ignoreExportsUsedInFile": true,
  "boundaries": {
    "zones": [
      {
        "name": "db",
        "patterns": ["frontend/src/lib/config/prisma.ts", "database/**"]
      },
      {
        "name": "data",
        "patterns": [
          "frontend/src/lib/*/queries.ts",
          "frontend/src/lib/*/mutations.ts",
          "frontend/src/lib/*/data-access.ts",
          "frontend/src/lib/*/actions.ts",
          "frontend/src/lib/*/service.ts",
          "frontend/src/lib/*/*-service.ts",
          "frontend/src/lib/*/schema.ts",
          "frontend/src/lib/*/serialization.ts",
          "frontend/src/lib/auth/**"
        ]
      },
      {
        "name": "hooks",
        "patterns": ["frontend/src/hooks/**"]
      },
      {
        "name": "ui",
        "patterns": [
          "frontend/src/app/**",
          "frontend/src/components/**",
          "frontend/src/providers/**"
        ]
      },
      {
        "name": "utils",
        "patterns": [
          "frontend/src/lib/utils/**",
          "frontend/src/lib/config/env.ts"
        ]
      },
      {
        "name": "shared",
        "patterns": ["shared/**"]
      },
      {
        "name": "services",
        "patterns": ["adapter/**", "backend/**", "predictor/**", "loadgen/**"]
      }
    ],
    "rules": [
      {
        "from": "ui",
        "allow": ["data", "hooks", "utils", "shared"],
        "allowTypeOnly": ["db"]
      },
      {
        "from": "hooks",
        "allow": ["data", "utils", "shared"],
        "allowTypeOnly": ["db"]
      },
      {
        "from": "data",
        "allow": ["db", "utils", "shared"]
      },
      {
        "from": "utils",
        "allow": []
      },
      {
        "from": "shared",
        "allow": []
      },
      {
        "from": "services",
        "allow": ["shared", "db"]
      }
    ]
  }
}
